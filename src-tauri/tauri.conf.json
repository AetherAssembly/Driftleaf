{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Driftleaf",
  "version": "0.6.4",
  "identifier": "org.aetherassembly.driftleaf.tauri-dev",
  "build": {
    "beforeDevCommand": "npm run dev:tauri:renderer",
    "beforeBuildCommand": "npm run build:tauri:renderer",
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist-tauri-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Driftleaf",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
